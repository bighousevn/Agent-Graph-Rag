{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python scripts/extract_case_features.py*)",
      "Bash(.venv/bin/python scripts/summarize_clusters.py*)",
      "Bash(.venv/bin/python scripts/build_law_layer.py*)",
      "Bash(.venv/bin/python scripts/judge_retrieval.py*)",
      "Bash(.venv/bin/python scripts/run_qa_pilot.py*)",
      "Bash(.venv/bin/python scripts/run_case_pipeline.py*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(grep * .env*)",
      "Bash(printenv*)",
      "Bash(env)"
    ]
  }
}