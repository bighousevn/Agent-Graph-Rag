# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# --- LLM (OpenAI-compatible endpoint) ---
# Works with OpenAI, DeepSeek, or any OpenAI-compatible gateway.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Or just set OPENAI_API_KEY (used when LLM_API_KEY is empty).
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=120

# --- Embedding ---
# backend: "vietnamese-bi-encoder" (default, PhoBERT-family, local CPU) or "bge-m3" (HTTP API, e.g. Ollama)
EMBEDDING_BACKEND=vietnamese-bi-encoder
EMBEDDING_MODEL=bkai-foundation-models/vietnamese-bi-encoder
EMBEDDING_MAX_SEQ_LENGTH=256
EMBEDDING_DEVICE=cpu
EMBEDDING_API_URL=http://localhost:11434/api/embed

# --- Paths ---
RAW_LAW_DOCX=data/raw/law/11_VBHN-VPQH_650257.docx
RAW_GUIDANCE_DIR=data/raw/guidance
RAW_CASES_DIR=data/raw/cases
PROCESSED_DIR=data/processed
OUTPUTS_DIR=outputs

# --- Misc ---
PROMPT_LANGUAGE=vi
CACHE_LLM_CALLS=true
CACHE_DIR=.cache/llm
